# Kopjo këtë skedë si `.env.local`:
#
#   cp .env.local.example .env.local
#
# Të dyja vlerat janë të mbushura tashmë dhe nuk ka nevojë t'i ndryshosh.
# Këto NUK janë sekrete: çelësi i mëposhtëm është "publik" me qëllim.
# Të dhënat mbrohen nga rregullat e bazës (RLS) + hyrja me llogari, jo nga ky çelës.

NEXT_PUBLIC_SUPABASE_URL=https://gfgwjwjoxsgrpmonumbn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ERo4RvnFxmt6DJP0A0Cx7Q_92kguP19

# ---------------------------------------------------------------------
# Çelësi i administratorit — KY ËSHTË SEKRET
# ---------------------------------------------------------------------
# I duhet vetëm një gjëje: hapjes së llogarive nga faqja «Përdoruesit».
# Ai i kapërcen të gjitha rregullat e sigurisë, prandaj:
#
#   - mos e vendos KURRË me parashtesën NEXT_PUBLIC_ (do të shkonte te
#     shfletuesi i çdo vizitori);
#   - mos e shkruaj në asnjë mesazh, foto ekrani apo depo publike;
#   - nëse të ka dalë ndonjëherë jashtë, ndërroje: Supabase -> Settings ->
#     API Keys -> service_role -> "Reset".
#
# E gjen te: Supabase -> Settings -> API Keys -> `service_role`.
# Shtoje edhe te Vercel -> Settings -> Environment Variables.

SUPABASE_SERVICE_ROLE_KEY=
